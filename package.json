{
  "name": "graph-memory",
  "version": "1.5.8",
  "description": "Knowledge Graph Memory Engine for OpenClaw — with Personalized PageRank, community detection, and vector dedup",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist",
    "index.ts",
    "src",
    "openclaw.plugin.json",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@photostructure/sqlite": "^1.0.0",
    "@sinclair/typebox": "^0.34.48",
    "openai": "^4.47.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "hooks": {},
    "compat": {
      "pluginApi": ">=2026.4.2"
    },
    "install": {
      "minHostVersion": ">=2026.4.2"
    }
  }
}
